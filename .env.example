# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env จะไม่ถูก commit)

# --- Database (ตรงกับ docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://cs:cs@localhost:5432/cs_assistant
TEST_DATABASE_URL=postgresql+psycopg://cs:cs@localhost:5432/cs_assistant_test

# --- LLM ---
# ollama | cloud | fake
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# ใช้เมื่อ LLM_PROVIDER=cloud
ANTHROPIC_API_KEY=
CLOUD_CHAT_MODEL=claude-sonnet-5-5
